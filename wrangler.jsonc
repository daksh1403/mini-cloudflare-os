{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mini-cloudflare-os",
	"main": "cloudflare_os/worker.py",
	"compatibility_date": "2025-11-02",
	"compatibility_flags": [
		"python_workers"
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "GADGETS",
				"class_name": "GadgetObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GadgetObject"
			]
		}
	],
	"observability": {
		"enabled": true
	}
}
